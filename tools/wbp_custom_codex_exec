set -euo pipefail

default_profile_dir="$HOME/Library/Application Support/WildBoarProxy/CodexProfiles/wbp-custom-main"
profile_dir="${WBP_PROFILE_DIR:-${CODEX_HOME:-$default_profile_dir}}"
codex_bin="${WBP_CODEX_BIN:-}"
if [[ -z "$codex_bin" ]]; then
  for app_path in \
    "${WBP_CODEX_APP_PATH:-}" \
    "/Applications/ChatGPT.app" \
    "$HOME/Applications/ChatGPT.app" \
    "/Applications/Codex.app" \
    "$HOME/Applications/Codex.app"; do
    [[ -n "$app_path" ]] || continue
    candidate="$app_path/Contents/Resources/codex"
    if [[ -x "$candidate" ]]; then
      codex_bin="$candidate"
      break
    fi
  done
fi

if [[ -z "$codex_bin" || ! -x "$codex_bin" ]]; then
  echo "WBP official Codex binary is not executable" >&2
  exit 127
fi

export CODEX_HOME="$profile_dir"
export WBP_PROFILE_DIR="$profile_dir"
export WBP_MANAGED_DIR="${WBP_MANAGED_DIR:-$profile_dir/managed}"
export WBP_CONFIG_TOML="${WBP_CONFIG_TOML:-$profile_dir/config.toml}"

exec "$codex_bin" exec "$@"
