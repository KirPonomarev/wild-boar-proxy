from __future__ import annotations

from pathlib import Path
import os
import shutil
import subprocess
import sys


MIN_PYTHON = (3, 10)


def _candidate_python_bins():
    env_value = os.environ.get("WBP_PYTHON_BIN")
    if env_value:
        yield env_value
    if sys.version_info >= MIN_PYTHON:
        yield sys.executable
    for name in ("python3.14", "python3.13", "python3.12", "python3.11", "python3.10"):
        found = shutil.which(name)
        if found:
            yield found
    for absolute in (
        "/opt/homebrew/opt/python@3.14/bin/python3.14",
        "/opt/homebrew/bin/python3",
        "/usr/local/bin/python3",
    ):
        yield absolute


def _python_is_supported(candidate):
    try:
        completed = subprocess.run(
            [
                str(candidate),
                "-c",
                "import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return completed.returncode == 0


def _ensure_supported_python():
    if sys.version_info >= MIN_PYTHON:
        return
    current = Path(sys.executable).expanduser().resolve(strict=False)
    for candidate in _candidate_python_bins():
        candidate_path = Path(str(candidate)).expanduser()
        if candidate_path.resolve(strict=False) == current:
            continue
        if _python_is_supported(candidate_path):
            os.execv(str(candidate_path), [str(candidate_path), __file__, *sys.argv[1:]])


_ensure_supported_python()

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from wild_boar_proxy.wbp_dip_tool import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
